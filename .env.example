# Banco de dados (necessário para a fonte Banco, cache e scrapers)
DB_HOST=
DB_DATABASE=
DB_USER=
DB_PASSWORD=
DB_PORT=5432

# Metadados
KEY_API_TMDB=
TOKEN_API_TMDB=

# Login administrativo (obrigatório para os controles do JDownloader)
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD_HASH=
FLASK_SECRET_KEY=
ADMIN_SESSION_HOURS=12
ADMIN_LOGIN_MAX_ATTEMPTS=5
ADMIN_LOGIN_WINDOW_MINUTES=15
SESSION_COOKIE_SECURE=false

# MyJDownloader
MYJD_EMAIL=
MYJD_PASSWORD=
MYJD_DEVICE=nome-do-dispositivo
MYJD_DOWNLOAD_FOLDER=/output
JDOWNLOADER_WEB_URL=

# OK.ru (opcional, usado pelo scraper/extractor quando necessário)
OKRU_EMAIL=
OKRU_PASSWORD=
OKRU_HEADLESS=True

# Scraper via requests (opcional)
OKRU_SERVER_IDS=
OKRU_MAX_WORKERS=2
OKRU_REQUESTS_DRY_RUN=0

# Analytics opcionais
CLOUDFLARE_BEACON_TOKEN=
ENABLE_VERCEL_ANALYTICS=false
